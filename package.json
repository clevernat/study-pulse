{
  "name": "studypulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "dev:local": "concurrently \"npm run emulators\" \"npm run dev\"",
    "seed:local": "node scripts/seed-local.mjs",
    "test:e2e": "npm run build:e2e && firebase emulators:exec --project demo-studypulse --only auth,firestore,hosting \"playwright test\"",
    "test:rules": "firebase emulators:exec --project demo-studypulse --only firestore \"jest --silent --roots tests/rules --testPathIgnorePatterns /node_modules/\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e",
    "build:e2e": "NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-studypulse NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-studypulse.firebaseapp.com NEXT_PUBLIC_USE_EMULATORS=1 next build",
    "test:e2e:only": "firebase emulators:exec --project demo-studypulse --only auth,firestore,hosting \"playwright test\""
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "firebase": "^12.13.0",
    "fzstd": "^0.1.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "sql.js": "^1.15.1",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sql.js": "^1.4.11",
    "concurrently": "^9.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jest": "^30.4.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5"
  }
}
