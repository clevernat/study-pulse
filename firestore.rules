rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own data.
    // One rule covers every collection under users/{uid}: subjects, sessions,
    // tasks, goals, topics, exams, classes, studyBlocks, habits, decks, notes,
    // cards, reviewLogs, reminders, devices, preferences, timerState, calendarFeed.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Secret calendar-feed links. The server (Admin SDK) reads these to find
    // the owner of a feed URL. A user may only create, read or delete their own.
    match /calendarTokens/{token} {
      allow get, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, update: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && token.size() >= 32;
    }

    // Everything else: no access.
  }
}
