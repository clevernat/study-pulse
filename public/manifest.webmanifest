{
  "name": "StudyPulse",
  "short_name": "StudyPulse",
  "description": "Flashcards, focus timer, exams, timetable and a study calendar in one app.",
  "id": "/",
  "start_url": "/today/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#08090a",
  "theme_color": "#08090a",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/today/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Review flashcards", "url": "/flashcards/review/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Focus timer", "url": "/timer/", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
